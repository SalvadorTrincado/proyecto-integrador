<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Área Personal del Administrador</title>
  <link rel="stylesheet" type="text/css" th:href="@{/css/area_personal.css}">
  <style>
    /* Estilos adicionales para los nuevos botones/secciones */
    .admin-actions, .admin-stats { /* Añadido .admin-stats */
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid #eee;
    }
    .admin-actions h3, .admin-stats h3 { /* Añadido .admin-stats h3 */
      margin-bottom: 15px;
      color: #333;
    }
    .action-button {
      display: inline-block;
      background-color: #007bff;
      color: white;
      padding: 10px 15px;
      margin: 5px;
      border: none;
      border-radius: 4px;
      text-decoration: none;
      font-size: 16px;
      transition: background-color 0.3s ease;
    }
    .action-button:hover {
      background-color: #0056b3;
      color: white;
    }
    .action-button.secondary {
      background-color: #6c757d;
    }
    .action-button.secondary:hover {
      background-color: #545b62;
    }
    .admin-stats p {
      margin: 5px 0;
      color: #555;
      text-align: left; /* Alinear a la izquierda dentro de la caja de estadísticas */
    }
  </style>
</head>
<body>
<div class="dashboard-container">
  <h2>Bienvenido, Administrador <span th:if="${administrador != null}" th:text="${administrador.email}"></span></h2>
  <p>Esta es tu área personal. Aquí podrás acceder a las diferentes funcionalidades de administración.</p>

  <div th:if="${administrador != null}" class="admin-stats">
    <h3>Estadísticas de Administrador</h3>
    <p>Email: <strong th:text="${administrador.email}"></strong></p>
    <p>Número total de autenticaciones: <strong th:text="${administrador.numeroAutenticacion != null ? administrador.numeroAutenticacion : 0}"></strong></p>
    <p>Estado: <strong th:text="${administrador.estaHabilitado ? 'Habilitado' : 'Deshabilitado'}"
                       th:style="${administrador.estaHabilitado ? 'color:green;' : 'color:red;'}"></strong></p>
  </div>

  <div class="admin-actions">
    <h3>Gestión de Empleados y Usuarios</h3>
    <a th:href="@{/admin/consulta-empleados}" class="action-button">Consultar Empleados (Vista API)</a>
    <a th:href="@{/admin/usuarios/gestion}" class="action-button secondary">Gestionar Usuarios (Bloqueo/Desbloqueo)</a>
  </div>

  <div class="admin-actions">
    <h3>Gestión de Etiquetas</h3>
    <a th:href="@{/admin/etiquetas}" class="action-button">Gestionar Catálogo de Etiquetas</a>
    <a th:href="@{/admin/etiquetas/asignar}" class="action-button secondary">Asignar Etiquetas a Empleado Individual</a>
    <a th:href="@{/admin/etiquetas/masivo}" class="action-button secondary">Etiquetado Masivo de Empleados</a>
  </div>

  <div class="admin-actions">
    <h3>Gestión de Productos</h3>
    <a th:href="@{/admin/productos}" class="action-button">Carga Masiva de Productos (CSV)</a>
  </div>

  <div class="admin-actions">
    <h3>Gestión de Nóminas</h3>
    <a th:href="@{/admin/nominas/crear}" class="action-button">Crear Nueva Nómina</a>
    <a th:href="@{/admin/nominas/consultar}" class="action-button">Consultar Nóminas</a>
  </div>

  <form th:action="@{/logout}" method="post" style="margin-top: 30px;">
    <input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}" th:if="${_csrf}"/>
    <button type="submit" class="logout-button">Desconectar</button>
  </form>
</div>
</body>
</html>