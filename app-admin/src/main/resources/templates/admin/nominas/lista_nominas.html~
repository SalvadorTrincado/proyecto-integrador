    function eliminarNominaConFetch(nominaId, csrfToken, csrfHeaderName) {
        if (confirm('¿Está seguro de que desea eliminar esta nómina? UUID: ' + nominaId)) {
            const url = /*[[@{/api/admin/nominas/}]]*/ '/api/admin/nominas/' + nominaId; // Construye la URL correctamente

            fetch(url, {
                method: 'DELETE',
                headers: {
                    // Spring Security espera el token CSRF en una cabecera por defecto para AJAX
                    // si no es una petición de tipo 'multipart/form-data' o 'application/x-www-form-urlencoded'
                    // El nombre de la cabecera es usualmente X-CSRF-TOKEN, que se obtiene de _csrf.headerName
                    [csrfHeaderName]: csrfToken
                }
            })
                .then(response => {
                    if (response.ok) {
                        // Intenta parsear como JSON si hay cuerpo, sino solo recarga
                        return response.text().then(text => text ? JSON.parse(text) : {});
                    } else {
                        // Intenta obtener el mensaje de error del cuerpo JSON
                        return response.json().then(data => {
                            throw new Error(data.error || `Error del servidor: ${response.status}`);
                        }).catch(() => {
                            // Si no hay cuerpo JSON o falla el parseo, usa el statusText
                            throw new Error(`Error del servidor: ${response.status} ${response.statusText}`);
                        });
                    }
                })
                .then(data => {
                    alert(data.mensaje || 'Nómina eliminada correctamente.');
                    window.location.reload(); // Recargar la página para ver los cambios
                })
                .catch(error => {
                    console.error('Error en fetch al eliminar:', error);
                    alert('Error al eliminar la nómina: ' + error.message);
                });
        }
    }
